# CampusSync & Smart Attendance Ecosystem - Environment Configuration

# --- Centralized Backend Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DATABASE_PATH=backend/faculty.db

# --- Optional AI Integrations (OCR Timetable Ingestion) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- ESP32 Bluetooth Classic Hardware Configuration ---
# Standard Serial over Bluetooth RFCOMM COM Port (Windows)
BLUETOOTH_PORT=COM14
# Dedicated USB Serial port for firmware flashing and hardware diagnostics
USB_DEBUG_PORT=COM13
BAUD_RATE=115200

# --- Attendance Watchdog Settings ---
# Production heartbeat interval: 300 seconds (5 minutes)
HEARTBEAT_INTERVAL=300

# Set TEST_MODE=true for rapid verification (15-second cycles)
TEST_MODE=false
TEST_HEARTBEAT_INTERVAL=15

# Response timeout in seconds for PING -> PONG
HEARTBEAT_TIMEOUT=3.0

# 3-Strike Rule Threshold (3 consecutive missed check-ins = ABSENT)
MAX_CONSECUTIVE_FAILURES=3

# --- Frontend Ports ---
# OD Management Application: Port 5173
# Smart Attendance Application: Port 5174 (or configured Vite port)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174"]

