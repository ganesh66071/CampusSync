# ESP32 Smart Classroom Attendance System - Configuration

# Hardware Port assignments
# COM14 is the active Standard Serial over Bluetooth Link mapped to ESP32_Attendance (B0:3F:D3:70:CD:B6)
BLUETOOTH_PORT=COM14
USB_DEBUG_PORT=COM13
BAUD_RATE=115200

# Heartbeat Interval Settings (in seconds)
# Production default: 300 seconds (5 minutes)
HEARTBEAT_INTERVAL=300

# Dev/Testing interval: set to 15-30 for rapid testing
# Set TEST_MODE=true to use TEST_HEARTBEAT_INTERVAL
TEST_MODE=true
TEST_HEARTBEAT_INTERVAL=15

# Response timeout in seconds for PING -> PONG
HEARTBEAT_TIMEOUT=3.0

# Failure threshold (Rule: 3 consecutive misses = ABSENT)
MAX_CONSECUTIVE_FAILURES=3

# Web Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
